# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4300

# Local TRAINING database (see ../database/setup-local.example.sql)
DB_HOST=127.0.0.1
# MySQL default is 3306; this machine uses 3309
DB_PORT=3309
DB_NAME=school_site_training
DB_USER=school_app
DB_PASSWORD=CHANGE_ME

# Sign-in and sessions
SESSION_IDLE_MINUTES_STAFF=15
SESSION_IDLE_MINUTES_DEFAULT=30
SESSION_MAX_HOURS=12
# true in production (HTTPS only)
COOKIE_SECURE=false
REQUIRE_STAFF_2FA=true
TOTP_ISSUER=Institution Website
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=CHANGE_ME
# Set to 1 when running behind a reverse proxy
TRUST_PROXY=
# Shared with the website server (same value in its settings): lets it pass on each visitor's real
# address, so rate limits count per visitor. 32+ random characters; required in production.
WEBSITE_SERVER_SECRET=

# Content
STORAGE_DIR=storage
# At least 32 random characters
PREVIEW_LINK_SECRET=CHANGE_ME
# Staff portal access keys are stored as HMAC-SHA-256 with this secret. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every access key and remembered staff browser.
PORTAL_KEY_SECRET=CHANGE_ME

# Backups (npm run backup / npm run backup:check)
BACKUP_DIR=backups
BACKUP_KEEP=14
# Folder with mysql/mysqldump if they are not on PATH
MYSQL_BIN_DIR=
